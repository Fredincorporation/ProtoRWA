{
  "name": "@protorwa/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "ProtoRWA Solidity contracts (Foundry).",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vv",
    "test:gas": "forge test --gas-report",
    "fmt": "forge fmt",
    "coverage": "forge coverage --report summary",
    "deploy:local": "forge script/Deploy.sol --rpc-url http://127.0.0.1:8545 --broadcast",
    "deploy:arb-sepolia": "forge script/Deploy.sol --rpc-url $ARBITRUM_SEPOLIA_RPC_URL --broadcast --verify",
    "lint": "forge fmt --check",
    "typecheck": "forge build --sizes"
  },
  "devDependencies": {
    "solc": "^0.8.37"
  }
}
