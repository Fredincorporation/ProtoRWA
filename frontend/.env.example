# ---------------------------------------------------------------------------
# ProtoRWA environment template.
#
# Copy to `.env.local` (committed-safe) and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored and takes precedence over `.env`. Never commit a
# file containing real keys.
# ---------------------------------------------------------------------------

# --- Data mode -------------------------------------------------------------
# mock  = seeded demo data (works offline, default)
# chain = read live contract state
NEXT_PUBLIC_DATA_MODE=mock

# --- AI providers (server-side only) ---------------------------------------
# Groq is primary. If it fails or rate-limits, Gemini is used automatically.
# Keys are read only in server code (app/api/ai/assist) and never shipped to the
# browser.
# GROQ_API_KEY=
#
# Optional model overrides. NOTE: setting GROQ_MODEL pins ONE model and disables
# the built-in preference fallback, so an unavailable id sends every request to
# the fallback provider instead of another Groq model. Confirm availability with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- WalletConnect (optional) ---------------------------------------------
# Omit to use only the injected connector (fine for desktop wallets).
# https://cloud.walletconnect.com
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Chains ----------------------------------------------------------------
# Values below are the PUBLISHED defaults baked into shared/src/chains.ts, which
# were verified by sending eth_chainId to each RPC. They are listed here only so
# a deployment can override them; leaving them unset is the normal case.
#
#   Robinhood Chain mainnet  id 4663   eth_chainId -> 0x1237
#   Robinhood Chain testnet  id 46630  eth_chainId -> 0xb626
#
# NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
# NEXT_PUBLIC_ROBINHOOD_TESTNET_CHAIN_ID=46630
# NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
#
# Set to "robinhood" to make Robinhood Chain the default connection. Left unset
# the app defaults to Arbitrum Sepolia, where the protocol contracts are deployed.
# NEXT_PUBLIC_DEFAULT_CHAIN=robinhood
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# --- USDG (Paxos Global Dollar) --------------------------------------------
# Settlement asset for RWA flows. 6 decimals, unlike ETH's 18 - all conversion
# goes through shared/src/settlement.ts so the two cannot be confused.
# Defaults are verified on-chain: symbol() === 'USDG', decimals() === 6.
#
# NEXT_PUBLIC_ARB_SEPOLIA_USDG=0xFFC95faa3d63Cde504a05B567C600B78C0b41892
# NEXT_PUBLIC_ROBINHOOD_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# NEXT_PUBLIC_ROBINHOOD_TESTNET_USDG=0x7E955252E15c84f5768B83c41a71F9eba181802F

# --- Robinhood Chain testnet (46630) - USDG-denominated deployment ---------
# Deployed with PAYMENT_TOKEN wired to USDG (0x7E95...802F) and HARDWARE_VERIFIER
# wired to the Stylus verifier. Verified on-chain: every address returns bytecode,
# the escrow reports USDG as paymentToken and holds the verifier, and a milestone
# with a committed root only opens its review once verifyHardwareBatch attests it.
NEXT_PUBLIC_ROBINHOOD_TESTNET_PROJECT_REGISTRY=0x5ceFdd224435BCd5D15C168a8d49d1640bC2FA2d
NEXT_PUBLIC_ROBINHOOD_TESTNET_CLAIM_TOKEN=0xDf349ff9E061A5A97a2CB1A35ba76A687f3648f3
NEXT_PUBLIC_ROBINHOOD_TESTNET_MILESTONE_ESCROW=0x7e433fd9fD65B6dD3Fd085361EC39BAb8ce37E70
NEXT_PUBLIC_ROBINHOOD_TESTNET_SECONDARY_MARKET=0x762D4A7d5dfa6287a729FC2B64C75b754A980705
# Stylus (Rust -> WASM) HardwareVerifier. The vote UI reads evaluateConsensus()
# from it to forecast settlement, and the escrow calls verifyHardwareBatch() to
# attest a milestone's committed telemetry root before its review may open.
NEXT_PUBLIC_ROBINHOOD_TESTNET_HARDWARE_VERIFIER=0x774a47d68c0148ffa14a154beb740154f0e4c129
# --- Deployed contract addresses (Arbitrum Sepolia - Chain ID: 421614) ---
NEXT_PUBLIC_PROJECT_REGISTRY=0xE9Aaa276502C691f824E2484eecF46C71Cb99eC3
NEXT_PUBLIC_CLAIM_TOKEN=0x5540b1b1049614F304368B17cd8eaBb80BE92dAD
NEXT_PUBLIC_MILESTONE_ESCROW=0x19f2190C1c50B2E4403ff4bd78c05598aBabbD16
NEXT_PUBLIC_SECONDARY_MARKET=0x2Ad4fCb52E9B41eBd11b49Ac9c6838ad27B20086
NEXT_PUBLIC_ARB_SEPOLIA_PROJECT_REGISTRY=0xE9Aaa276502C691f824E2484eecF46C71Cb99eC3
NEXT_PUBLIC_ARB_SEPOLIA_CLAIM_TOKEN=0x5540b1b1049614F304368B17cd8eaBb80BE92dAD
NEXT_PUBLIC_ARB_SEPOLIA_MILESTONE_ESCROW=0x19f2190C1c50B2E4403ff4bd78c05598aBabbD16
NEXT_PUBLIC_ARB_SEPOLIA_SECONDARY_MARKET=0x2Ad4fCb52E9B41eBd11b49Ac9c6838ad27B20086
NEXT_PUBLIC_ARB_SEPOLIA_HARDWARE_VERIFIER=0x510f4d65e9f7778b09ad52a4ec19c590a934f913
