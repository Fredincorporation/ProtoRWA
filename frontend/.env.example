# ---------------------------------------------------------------------------
# ProtoRWA environment template.
#
# Copy to `.env.local` (committed-safe) and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored and takes precedence over `.env`. Never commit a
# file containing real keys.
# ---------------------------------------------------------------------------

# --- Data mode -------------------------------------------------------------
# mock  = seeded demo data (works offline, default)
# chain = read live contract state
NEXT_PUBLIC_DATA_MODE=mock

# --- AI providers (server-side only) ---------------------------------------
# Groq is primary. If it fails or rate-limits, Gemini is used automatically.
# Keys are read only in server code (app/api/ai/assist) and never shipped to the
# browser.
# GROQ_API_KEY=
#
# Optional model overrides. NOTE: setting GROQ_MODEL pins ONE model and disables
# the built-in preference fallback, so an unavailable id sends every request to
# the fallback provider instead of another Groq model. Confirm availability with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- WalletConnect (optional) ---------------------------------------------
# Omit to use only the injected connector (fine for desktop wallets).
# https://cloud.walletconnect.com
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Chains ----------------------------------------------------------------
# Robinhood Chain is the primary target. Leave blank until the id/RPC are
# confirmed; the app then falls back to Arbitrum Sepolia.
# NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=

NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --- Deployed contract addresses (Arbitrum Sepolia - Chain ID: 421614) ---
NEXT_PUBLIC_PROJECT_REGISTRY=0xE9Aaa276502C691f824E2484eecF46C71Cb99eC3
NEXT_PUBLIC_CLAIM_TOKEN=0x5540b1b1049614F304368B17cd8eaBb80BE92dAD
NEXT_PUBLIC_MILESTONE_ESCROW=0x19f2190C1c50B2E4403ff4bd78c05598aBabbD16
NEXT_PUBLIC_SECONDARY_MARKET=0x2Ad4fCb52E9B41eBd11b49Ac9c6838ad27B20086
