# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Foundry
contracts/out/
contracts/cache/
# Keep broadcast receipts — show deployed contract addresses for judges
# contracts/broadcast/

# Rust / Cargo — exclude target dirs (large) but keep compiled wasm artifact
contracts/stylus/*/target/
!contracts/stylus/hardware-verifier/target/wasm32-unknown-unknown/release/hardware_verifier.wasm

# Environment - never commit real keys.
# `.env.example` is a template with no secrets and SHOULD be committed, so the
# negation below is required (and must come after the exclusions).
.env
.env.*
!.env.example

# Design source (Stitch mockups, token dumps, generator scripts) is a local
# design reference, not part of the shipped app — keep it out of version control.
design-source/

# Vendored Foundry toolchain binaries — installed via foundryup, never committed.
.tools/

# AI-agent session state (Kilo Code task history).
.kilocode/

# Runtime logs anywhere in the tree.
*.log

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*.log
